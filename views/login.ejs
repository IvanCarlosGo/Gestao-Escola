<!DOCTYPE html>
<html lang="pt-PT">
<head>
  <%- include('partials/head') %>
</head>
<body class="login-body login-marca">
  <main class="login-wrap">
    <div class="login-card">
      <div class="login-brand">
        <img src="<%= marca.simbolo %>" alt="" class="login-simbolo" width="64" height="64">
        <h1 class="marca-nome"><%= marca.nome %></h1>
        <p><%= marca.descricao %></p>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></div>
      <% } %>

      <form method="POST" action="/login" class="login-form">
        <input type="hidden" name="next" value="<%= next %>">

        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" value="<%= email %>" autocomplete="username" required autofocus>
        </div>

        <div class="form-group">
          <label for="palavra_passe">Palavra-passe</label>
          <input type="password" id="palavra_passe" name="palavra_passe" autocomplete="current-password" required>
        </div>

        <button type="submit" class="btn btn-primary btn-block">
          <i class="fa-solid fa-right-to-bracket"></i> Entrar
        </button>
      </form>

      <p class="login-foot">Esqueceu-se da palavra-passe? Peça ao administrador para a redefinir.</p>
    </div>
    <p class="login-slogan"><%= marca.slogan %></p>
  </main>
</body>
</html>
