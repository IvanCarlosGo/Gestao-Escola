<!DOCTYPE html>
<html lang="pt-PT">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <div class="app-layout">
    <%- include('../partials/sidebar') %>

    <div class="main-content">
      <%- include('../partials/topbar', {
        pageSubtitle: 'Quem pode entrar na aplicação e com que perfil.',
        pageAction: '<a href="/utilizadores/novo" class="btn btn-primary"><i class="fa-solid fa-user-plus"></i> Novo Utilizador</a>'
      }) %>

      <main class="content-body">

        <% if (success) { %>
          <div class="alert alert-success"><i class="fa-solid fa-circle-check"></i> <%= success %></div>
        <% } %>
        <% if (error) { %>
          <div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></div>
        <% } %>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Nome</th>
                <th>Email</th>
                <th>Perfil</th>
                <th>Estado</th>
                <th class="th-actions">Ações</th>
              </tr>
            </thead>
            <tbody>
              <% contas.forEach(c => { %>
                <tr>
                  <td>
                    <span class="person-cell">
                      <span class="avatar avatar-sm <%= avatarCor(c.id) %>"><%= iniciais(c.nome) %></span>
                      <span class="cell-name"><%= c.nome %></span>
                      <% if (c.id === utilizador.id) { %><span class="badge badge-muted">Você</span><% } %>
                    </span>
                  </td>
                  <td class="cell-muted"><%= c.email %></td>
                  <td><span class="badge <%= c.perfil === 'admin' ? 'badge-neutral' : 'badge-muted' %>"><%= perfis[c.perfil] %></span></td>
                  <td>
                    <% if (c.ativo) { %><span class="badge badge-success">Ativo</span><% } else { %><span class="badge badge-danger">Desativado</span><% } %>
                  </td>
                  <td class="th-actions">
                    <div class="actions-cell" style="justify-content: center;">
                      <a href="/utilizadores/<%= c.id %>/editar" class="btn btn-outline btn-sm btn-icon" title="Editar"><i class="fa-solid fa-pen"></i></a>
                      <% if (c.id !== utilizador.id) { %>
                        <form action="/utilizadores/<%= c.id %>?_method=DELETE" method="POST" data-confirm="Eliminar o utilizador <%= c.nome %>?">
                          <button type="submit" class="btn btn-danger-ghost btn-sm btn-icon" title="Eliminar"><i class="fa-regular fa-trash-can"></i></button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="card perfis-info">
          <div class="card-header"><h3>Perfis</h3></div>
          <div class="legend-item"><span class="legend-dot green"></span><div><strong>Administrador</strong><span>Acesso total: professores, turmas, disciplinas, horários, faltas, relatórios e utilizadores.</span></div></div>
          <div class="legend-item"><span class="legend-dot amber"></span><div><strong>Secretaria</strong><span>Consulta tudo, edita e justifica faltas e gera relatórios. Não altera professores, turmas, disciplinas nem horários.</span></div></div>
          <div class="legend-item"><span class="legend-dot red"></span><div><strong>Contínuo</strong><span>Só a aplicação móvel: vê quem tem aula agora e regista faltas. Não entra neste site.</span></div></div>
        </div>

      </main>
    </div>
  </div>
  <%- include('../partials/scripts') %>
</body>
</html>
