<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand">
    <% const escolaAtual = typeof escola !== 'undefined' && escola ? escola : null; %>
    <div class="brand-icon">
      <% if (escolaAtual && escolaAtual.logo) { %>
        <img src="<%= escolaAtual.logo %>" alt="Logótipo <%= escolaAtual.sigla || escolaAtual.nome %>">
      <% } else { %>
        <i class="fa-solid fa-graduation-cap brand-fallback"></i>
      <% } %>
    </div>
    <%# Sigla em destaque e, por baixo, o nome completo da escola %>
    <div class="brand-text brand-escola">
      <strong><%= escolaAtual ? (escolaAtual.sigla || 'Gestão Escolar') : 'Gestão Escolar' %></strong>
      <span><%= escolaAtual ? escolaAtual.nome : 'Faltas dos Professores' %></span>
    </div>
  </div>

  <nav class="sidebar-nav">
    <a href="/" class="nav-item <%= activePage === 'dashboard' ? 'active' : '' %>">
      <span class="nav-icon"><i class="fa-solid fa-house"></i></span>
      <span>Dashboard</span>
    </a>
    <a href="/professores" class="nav-item <%= activePage === 'professores' ? 'active' : '' %>">
      <span class="nav-icon"><i class="fa-solid fa-user-group"></i></span>
      <span>Professores</span>
    </a>
    <a href="/faltas" class="nav-item <%= activePage === 'historico' ? 'active' : '' %>">
      <span class="nav-icon"><i class="fa-regular fa-clock"></i></span>
      <span>Registos de Faltas</span>
    </a>
    <a href="/relatorios" class="nav-item <%= activePage === 'relatorios' ? 'active' : '' %>">
      <span class="nav-icon"><i class="fa-solid fa-chart-simple"></i></span>
      <span>Relatórios</span>
    </a>
    <a href="/horarios" class="nav-item <%= activePage === 'horarios' ? 'active' : '' %>">
      <span class="nav-icon"><i class="fa-regular fa-calendar"></i></span>
      <span>Horários</span>
    </a>
    <a href="/turmas" class="nav-item <%= activePage === 'turmas' ? 'active' : '' %>">
      <span class="nav-icon"><i class="fa-solid fa-people-group"></i></span>
      <span>Turmas</span>
    </a>
    <a href="/disciplinas" class="nav-item <%= activePage === 'disciplinas' ? 'active' : '' %>">
      <span class="nav-icon"><i class="fa-solid fa-book-open"></i></span>
      <span>Disciplinas</span>
    </a>
    <% if (typeof ehAdmin !== 'undefined' && ehAdmin) { %>
      <a href="/utilizadores" class="nav-item <%= activePage === 'utilizadores' ? 'active' : '' %>">
        <span class="nav-icon"><i class="fa-solid fa-user-shield"></i></span>
        <span>Utilizadores</span>
      </a>
    <% } %>
    <a href="/configuracoes" class="nav-item <%= activePage === 'configuracoes' ? 'active' : '' %>">
      <span class="nav-icon"><i class="fa-solid fa-gear"></i></span>
      <span>Definições</span>
    </a>
  </nav>

  <% if (typeof utilizador !== 'undefined' && utilizador) { %>
    <div class="sidebar-footer">
      <div class="user-chip">
        <a href="/configuracoes" class="user-avatar" title="A minha conta"><%= iniciais(utilizador.nome) %></a>
        <span class="user-info">
          <strong><%= utilizador.nome %></strong>
          <span><%= nomePerfil %></span>
        </span>
        <form method="POST" action="/logout">
          <button type="submit" class="user-logout" title="Terminar sessão" aria-label="Terminar sessão">
            <i class="fa-solid fa-arrow-right-from-bracket"></i>
          </button>
        </form>
      </div>
    </div>
  <% } %>
</aside>
<div class="sidebar-overlay" id="sidebarOverlay"></div>
