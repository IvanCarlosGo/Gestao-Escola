PORT=3000

DB_HOST=db
DB_PORT=3306
DB_USER=escola_user
DB_PASSWORD=escola_pass
DB_NAME=gestao_escolar
DB_ROOT_PASSWORD=root_pass

# Fuso horário da escola (Cabo Verde)
TZ=Atlantic/Cape_Verde

# Sessões: chave secreta longa e aleatória (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=
# Administrador criado no primeiro arranque (sem ADMIN_PASSWORD é gerada uma e mostrada nos logs)
ADMIN_EMAIL=admin@escola.cv
ADMIN_PASSWORD=
# Pôr 1 quando a aplicação estiver em HTTPS
COOKIE_SECURE=0
