<%- include('../partials/inicio', {
  pageSubtitle: 'Administradores, secretarias e contínuos de todas as escolas.',
  pageAction: '<a href="/utilizadores/novo" class="btn btn-primary"><i class="fa-solid fa-user-plus"></i> Novo utilizador</a>'
}) %>

<form class="filters-bar" method="GET" action="/utilizadores">
  <select name="escola_id">
    <option value="">Todas as escolas</option>
    <% escolas.forEach(e => { %>
      <option value="<%= e.id %>" <%= String(filtros.escola_id) === String(e.id) ? 'selected' : '' %>><%= e.nome %></option>
    <% }) %>
  </select>
  <select name="perfil">
    <option value="">Todos os perfis</option>
    <% Object.entries(perfis).forEach(([valor, nome]) => { %>
      <option value="<%= valor %>" <%= filtros.perfil === valor ? 'selected' : '' %>><%= nome %></option>
    <% }) %>
  </select>
  <input type="search" name="q" value="<%= filtros.q %>" placeholder="Nome ou email">
  <div class="filters-actions">
    <a href="/utilizadores" class="btn btn-soft btn-sm"><i class="fa-solid fa-rotate-left"></i> Limpar</a>
    <button type="submit" class="btn btn-primary btn-sm"><i class="fa-solid fa-filter"></i> Filtrar</button>
  </div>
</form>

<div class="table-wrap">
  <% if (contas.length === 0) { %>
    <div class="empty-state">
      <i class="fa-solid fa-users"></i>
      <p>Nenhum utilizador encontrado.</p>
    </div>
  <% } else { %>
    <table>
      <thead><tr><th>Nome</th><th>Email</th><th>Escola</th><th>Perfil</th><th>Estado</th><th class="th-actions">Ações</th></tr></thead>
      <tbody>
        <% contas.forEach(c => { %>
          <tr>
            <td><span class="person-cell"><span class="avatar avatar-sm <%= avatarCor(c.id) %>"><%= iniciais(c.nome) %></span><span class="cell-name"><%= c.nome %></span></span></td>
            <td class="cell-muted"><%= c.email %></td>
            <td>
              <a href="/escolas/<%= c.escola_id %>" class="link-plain"><%= c.escola_sigla || c.escola_nome %></a>
              <% if (!c.escola_ativa) { %><span class="badge badge-danger">suspensa</span><% } %>
            </td>
            <td><span class="badge perfil-<%= c.perfil %>"><%= perfis[c.perfil] %></span></td>
            <td><% if (c.ativo) { %><span class="badge badge-success">Ativa</span><% } else { %><span class="badge badge-muted">Desativada</span><% } %></td>
            <td class="th-actions">
              <div class="actions-cell" style="justify-content: center;">
                <a href="/utilizadores/<%= c.id %>/editar" class="btn btn-outline btn-sm btn-icon" title="Editar / redefinir palavra-passe"><i class="fa-solid fa-pen"></i></a>
                <form method="POST" action="/utilizadores/<%= c.id %>/estado">
                  <button type="submit" class="btn btn-outline btn-sm btn-icon" title="<%= c.ativo ? 'Desativar' : 'Ativar' %>"><i class="fa-solid <%= c.ativo ? 'fa-user-slash' : 'fa-user-check' %>"></i></button>
                </form>
                <form method="POST" action="/utilizadores/<%= c.id %>?_method=DELETE" data-confirm="Eliminar a conta de <%= c.nome %>?">
                  <button type="submit" class="btn btn-danger-ghost btn-sm btn-icon" title="Eliminar"><i class="fa-regular fa-trash-can"></i></button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/fim') %>
